# Copie para .env e ajuste. Nunca versione o .env.

# Chave das rotas de escrita (importação, sync, alertas). Gere com: openssl rand -hex 32
API_KEY=

# Fontes de dados, separadas por vírgula: demo, files, aws, azure
SOURCES=demo

# files: exports FOCUS, AWS CUR ou Azure Cost Details em ./data
DATA_DIR=./data

# aws: Cost Explorer (credenciais pela cadeia padrão do SDK: IAM role, SSO, AWS_PROFILE)
AWS_PAYER_ACCOUNT_ID=

# azure: Cost Management (DefaultAzureCredential: AZURE_CLIENT_ID/AZURE_TENANT_ID/AZURE_CLIENT_SECRET ou managed identity)
AZURE_SCOPE=/subscriptions/00000000-0000-0000-0000-000000000000

# Orçamentos mensais (JSON). Escopo opcional por dimensão: service, provider, subAccount, region ou tag:<chave>
BUDGETS=[{"id":"total","name":"Conta inteira","amount":4600},{"id":"pagamentos","name":"Time pagamentos","amount":2600,"scope":{"dimension":"tag:team","key":"pagamentos"}}]

# Tags obrigatórias para showback
REQUIRED_TAGS=team,env

# Alertas (opcionais)
ALERT_SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_MIN_SEVERITY=medium
ALERT_INTERVAL_MINUTES=60
SYNC_INTERVAL_MINUTES=360
